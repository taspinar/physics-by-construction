# Local environment files. .env.example is the committed template.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/

# Built site and Quarto's working files. Figures, outputs, and rendered pages
# are regenerated by every build and never committed.
site/_site/
site/.quarto/
site/**/*_files/
*.quarto_ipynb
# While it renders, Quarto writes each page and the shared libraries next to
# the sources before it moves them to site/_site/. Without these rules a
# clean checkout looks changed during its own build, and a lesson's
# "Reproduce this" section reports uncommitted changes. Only the places where
# pages are rendered are listed, so an HTML source elsewhere, such as a widget
# in site/widgets/, is still tracked.
/site/*.html
/site/lessons/**/*.html
/site/site_libs/
.ipynb_checkpoints/

# Lean build products and fetched packages, including Mathlib
lean/.lake/

# Credentials / keys
*.pem
*.key
service-account*.json
credentials*.json

# Review and triage results are working files; their reports are published
# on the feature Issue instead of being committed.
.agents/reviews/*
!.agents/reviews/.gitkeep
.agents/triage/*
!.agents/triage/.gitkeep

.DS_Store
*.log
