# Local environment files. .env.example is the committed template.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/

# Built site and Quarto's working files. Figures, outputs, and rendered pages
# are regenerated by every build and never committed.
site/_site/
site/.quarto/
site/**/*_files/
*.quarto_ipynb
.ipynb_checkpoints/

# Lean build products and fetched packages, including Mathlib
lean/.lake/

# Credentials / keys
*.pem
*.key
service-account*.json
credentials*.json

# Review and triage results are working files; their reports are published
# on the feature Issue instead of being committed.
.agents/reviews/*
!.agents/reviews/.gitkeep
.agents/triage/*
!.agents/triage/.gitkeep

.DS_Store
*.log
