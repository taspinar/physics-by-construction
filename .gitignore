# Local environment files. .env.example is the committed template.
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/

# Built site and Quarto's working files. Figures, outputs, and rendered pages
# are regenerated by every build and never committed.
site/_site/
site/.quarto/
site/**/*_files/
*.quarto_ipynb
# While it renders, Quarto writes each page and the shared libraries next to
# the sources before it moves them to site/_site/. Without these rules a
# clean checkout looks changed during its own build, and a lesson's
# "Reproduce this" section reports uncommitted changes. Every page can be
# rendered anywhere under site/, so all HTML there is ignored, except where
# HTML is a source: widgets, and directories Quarto does not render (their
# names start with an underscore). tests/integration/test_build_output.py
# checks that every page's output is covered.
/site/**/*.html
!/site/widgets/**
!/site/_*/**
/site/site_libs/
.ipynb_checkpoints/

# Lean build products and fetched packages, including Mathlib
lean/.lake/

# Credentials / keys
*.pem
*.key
service-account*.json
credentials*.json

# Review and triage results are working files; their reports are published
# on the feature Issue instead of being committed.
.agents/reviews/*
!.agents/reviews/.gitkeep
.agents/triage/*
!.agents/triage/.gitkeep
# Steps a feature needs from the human, written by the implementer. They are
# copied into the commit message and the pull request.
.agents/manual-steps/
# The record of the last passed verification of this working tree.
.agents/verification/

.DS_Store
*.log
